{
  "coreName": "Gearcoleco",
  "systemNames": {
    "CV": "ColecoVision",
    "ADAM": "Coleco ADAM"
  },
  "author": "Ignacio Sanchez (Gearcoleco); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-gearcoleco",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    4,
    4,
    32
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap; waterbox/run-wbx.c carries the same numbers. A cartridge is at most 8 MiB, read whole and copied once; the ADAM's four drives hold at most 320 KiB each.",
  "video": {
    "_comment": "buffer capacity: the F18A draws up to 512x288. The live size comes from GetVideoWidth/Height each frame (256x192 without overscan).",
    "width": 512,
    "height": 288,
    "virtualWidth": 256,
    "virtualHeight": 192,
    "vsyncNumerator": 3579545,
    "vsyncDenominator": 59736,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 2048,
    "channels": 2,
    "rate": 44100,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "_machines_note": "One core.wbx, two machines. The ColecoVision runs a cartridge; the ADAM is the ColecoVision's computer, with its own three ROMs, a keyboard, two disk drives and two data pack drives, and the cartridge slot. The setting 'machine' says which; a project pins it.",
  "machineSetting": "machine",
  "machines": [
    {
      "id": "CV",
      "label": "ColecoVision",
      "when": [
        "colecovision"
      ],
      "input": {
        "name": "ColecoVision Controls",
        "_comment": "index order is the wire: 0 Reset, 1-20 player 1's controller, 21-40 player 2's. The spinners are the movement of the Super Action Controller's, the wheel's or the roller's this frame.",

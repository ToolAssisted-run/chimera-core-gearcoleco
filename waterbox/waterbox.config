      "optionLabels": {
        "auto": "option.auto",
        "tms9918a": "option.videochip.tms9918a",
        "f18a": "option.videochip.f18a"
      },
      "default": "auto",
      "description": "setting.videochip.about"
    },
    {
      "name": "noSpriteLimit",
      "display": "setting.nospritelimit",
      "type": "bool",
      "default": false,
      "description": "setting.nospritelimit.about"
    },
    {
      "name": "overscan",
      "display": "setting.overscan",
      "type": "enum",
      "options": [
        "none",
        "topBottom",
        "full284",
        "full320"
      ],
      "optionLabels": {
        "none": "option.overscan.none",
        "topBottom": "option.overscan.topbottom",
        "full284": "option.overscan.full284",

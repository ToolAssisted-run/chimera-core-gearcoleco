  "settings": [
    {
      "name": "machine",
      "display": "setting.machine",
      "type": "enum",
      "options": [
        "colecovision",
        "adam"
      ],
      "optionLabels": {
        "colecovision": "option.machine.colecovision",
        "adam": "option.machine.adam"
      },
      "default": "colecovision",
      "description": "setting.machine.about"
    },
    {
      "name": "region",
      "display": "setting.region",
      "type": "enum",
      "options": [
        "auto",
        "ntsc",
        "pal"
      ],
      "optionLabels": {
        "auto": "option.auto",
        "ntsc": "option.region.ntsc",
        "pal": "option.region.pal"
      },
      "default": "auto",
      "description": "setting.region.about"
    },
    {
      "name": "mapper",
      "display": "setting.mapper",
      "type": "enum",
      "options": [
        "auto",
        "standard",
        "megacart",
        "activision",
        "ocm"
      ],
      "optionLabels": {
        "auto": "option.auto",
        "standard": "option.mapper.standard",
